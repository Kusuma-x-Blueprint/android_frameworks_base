<com.android.systemui.statusbar.pipeline.networktraffic.ui.view.ModernStatusBarNetworkTrafficView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/network_traffic_combo"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:gravity="center_vertical">

    <org.lineageos.internal.statusbar.NetworkTraffic
        android:id="@+id/network_traffic_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textAppearance="@style/TextAppearance.StatusBar.Default"
        android:maxLines="2"
        android:includeFontPadding="false"
        android:lineSpacingMultiplier="0.75"
        android:gravity="center"
        android:paddingStart="2dp"
        android:paddingEnd="2dp" />

</com.android.systemui.statusbar.pipeline.networktraffic.ui.view.ModernStatusBarNetworkTrafficView>
