<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <!-- SysUI Tuner: Network traffic setting title [CHAR LIMIT=NONE] -->
    <string name="status_bar_network_traffic_title">Network traffic</string>

    <!-- SysUI Tuner: Options for how network traffic is displayed [CHAR LIMIT=NONE] -->
    <string-array name="network_traffic_options">
        <item>Always show</item>
        <item>Show when there is network traffic</item>
        <item>Don\'t show this icon (default)</item>
    </string-array>

    <!-- SysUI Tuner: Clock AM/PM title [CHAR LIMIT=NONE] -->
    <string name="status_bar_am_pm_title">AM/PM</string>

    <!-- SysUI Tuner: Clock AM/PM 24-hour summary [CHAR LIMIT=NONE] -->
    <string name="status_bar_am_pm_info">24-hour clock is enabled</string>

    <!-- SysUI Tuner: Clock position setting title [CHAR LIMIT=NONE] -->
    <string name="tuner_clock_position">Clock position</string>

    <!-- SysUI Tuner: Options for clock position [CHAR LIMIT=NONE] -->
    <string-array name="clock_position_options">
        <item>Show on the left (default)</item>
        <item>Show in the center</item>
        <item>Show on the right</item>
    </string-array>

    <string-array name="clock_position_options_notch">
        <item>Show on the left (default)</item>
        <item>Show on the right</item>
    </string-array>

    <string-array name="clock_position_options_rtl">
        <item>Show on the right (default)</item>
        <item>Show in the center</item>
        <item>Show on the left</item>
    </string-array>

    <string-array name="clock_position_options_notch_rtl">
        <item>Show on the right (default)</item>
        <item>Show on the left</item>
    </string-array>

    <!-- SysUI Tuner: Battery style setting title [CHAR LIMIT=NONE] -->
    <string name="tuner_battery_style">Battery style</string>

    <!-- SysUI Tuner: Options for battery style [CHAR LIMIT=NONE] -->
    <string-array name="battery_style_options">
        <item>Show horizontal icon (default)</item>
        <item>Show circle icon</item>
        <item>Show dotted circle icon</item>
        <item>Show text only</item>
    </string-array>

    <!-- SysUI Tuner: Battery percentage setting title [CHAR LIMIT=NONE] -->
    <string name="tuner_battery_percentage">Battery percentage</string>

    <!-- SysUI Tuner: Options for battery percentage [CHAR LIMIT=NONE] -->
    <string-array name="battery_percentage_options">
        <item>Show percentage next to the icon</item>
        <item>Show percentage inside the icon</item>
        <item>Don\'t show percentage (default)</item>
    </string-array>

    <!-- Label for UI element which allows to use lens on screenshot [CHAR LIMIT=30] -->
    <string name="screenshot_lens_label">Lens</string>
</resources>
